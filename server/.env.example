# Groq API Key
GROQ_API=your_groq_api_key_here

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Redis Configuration (for rate limiting)
REDIS_URL=redis://localhost:6379/0

# Pinecone Configuration (for managed Vector DB)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=resume-reviewer
PINECONE_ENVIRONMENT=us-east-1

# Optional: Vector DB Persistence
COLLECTION_NAME=ResumeDatabase

# Deployment Configuration
AI_MODEL=llama-3.1-8b-instant
ALLOWED_ORIGINS=http://localhost:3000,https://your-production-app.com
